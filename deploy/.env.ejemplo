# Copiar a deploy/.env en CADA instancia y llenar con las IPs PRIVADAS
# de tus instancias. El .env no se sube a git: lleva secretos.
#
# Ejemplo: ControlNode1..3 = 172.31.0.11-13, DataNode1..4 = 172.31.0.21-24

# ===== distinto en cada instancia =====

# ControlNode1, ControlNode2, ControlNode3, DataNode1 ... DataNode4
NODE_ID=ControlNode1

# Solo ControlNodes: la IP privada de esta instancia
MI_IP=172.31.0.11

# Solo DataNodes: la IP privada de esta instancia
ADVERTISE_IP=172.31.0.21

# Solo ControlNodes: los OTROS dos ControlNodes
RAFT_PEERS=172.31.0.12:50052,172.31.0.13:50052

# ===== igual en todas =====

NAMENODE_ADDR=172.31.0.11:50051,172.31.0.12:50051,172.31.0.13:50051
NAMENODES_CLIENTE=172.31.0.11:50052=172.31.0.11:50051,172.31.0.12:50052=172.31.0.12:50051,172.31.0.13:50052=172.31.0.13:50051
DFSHA_SECRET=cambia-esto-por-algo-largo-y-aleatorio
DFSHA_BLOCK_SECRET=cambia-esto-tambien
RAFT_PASSWORD=y-esto
